prefix=/g/g0/holger/workspace/magma/install/magma_hip
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: magma
Description: Matrix Algebra on GPU and Multicore Architectures
Version: 0.0.0
Cflags: -I${includedir}  -std=c++11 -DADD_ -fopenmp=libomp -D__HIP_PLATFORM_HCC__ -DROCM_VERSION=60101 -w -Wall -Wno-unused-function -I/opt/rocm-6.1.1/include -I/g/g0/holger/workspace/magma/build_hip/include -I/g/g0/holger/workspace/magma/include -I/g/g0/holger/workspace/magma/control -I/g/g0/holger/workspace/magma/magmablas_hip 
Libs: -L${libdir} -lmagma_sparse -lmagma  /usr/lib64/libopenblas.so -lm -ldl   
Libs.private:
Requires: 
Requires.private:
